-- ------------------------------------------------------------------------------
--  TAB SYSTEM
-- ------------------------------------------------------------------------------
local tabs = {}
local activeTab = nil

local function makeTab(name, icon)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = COLORS.sidebar
	btn.Text = ""
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = sidebar
	corner(btn, 6)

	local iconL = label(btn, icon, 14, COLORS.textDim, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	iconL.Size = UDim2.new(0, 28, 1, 0)
	iconL.Position = UDim2.new(0, 4, 0, 0)

	local nameL = label(btn, name, 12, COLORS.textDim, Enum.Font.GothamSemibold)
	nameL.Size = UDim2.new(1, -36, 1, 0)
	nameL.Position = UDim2.new(0, 34, 0, 0)

	local content = Instance.new("ScrollingFrame")
	content.Size = UDim2.new(1, 0, 1, 0)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 3
	content.ScrollBarImageColor3 = COLORS.accent
	content.CanvasSize = UDim2.new(0, 0, 0, 0)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.Visible = false
	content.Parent = panel

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.Parent = content
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = content

	local tabData = { btn = btn, content = content, iconL = iconL, nameL = nameL }
	tabs[name] = tabData

	btn.MouseButton1Click:Connect(function()
		if activeTab then
			activeTab.content.Visible = false
			activeTab.btn.BackgroundColor3 = COLORS.sidebar
			activeTab.iconL.TextColor3 = COLORS.textDim
			activeTab.nameL.TextColor3 = COLORS.textDim
		end
		activeTab = tabData
		content.Visible = true
		btn.BackgroundColor3 = COLORS.card
		iconL.TextColor3 = COLORS.accent
		nameL.TextColor3 = COLORS.text
	end)

	return content
end

