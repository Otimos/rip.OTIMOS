tabs["Ores"].nameL.TextColor3 = COLORS.text
tabs["Ores"].content.Visible = true
activeTab = tabs["Ores"]

-- ------------------------------------------------------------------------------
--  ORE ESP
-- ------------------------------------------------------------------------------
local oreAdornments  = {}
local oreESPEnabled  = false
local showTracers    = false
local maxEspDistance = 1000

local function addOreESP(part)
	if not part:IsA("BasePart") then return end
	if oreAdornments[part] then return end
	local color = part.Color
	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = part box.Size = part.Size box.Color3 = color
	box.Transparency = 0.5 box.ZIndex = 5 box.AlwaysOnTop = true
	box.Parent = workspace.CurrentCamera box.Visible = oreESPEnabled
	local tracer = Drawing.new("Line")
	tracer.Visible = false tracer.Color = color tracer.Thickness = 1 tracer.Transparency = 1
	oreAdornments[part] = { box = box, tracer = tracer, inRange = true }
end

local function removeOreESP(part)
	local d = oreAdornments[part]
	if d then if d.box then d.box:Destroy() end if d.tracer then d.tracer:Remove() end oreAdornments[part] = nil end
end

local function clearAllOreESP()
	for part in pairs(oreAdornments) do removeOreESP(part) end
end

local espSec = makeSection(oresTab, "ESP Settings")
makeToggle(espSec, "Show Ore ESP", false, function(v)
	oreESPEnabled = v
	if v then
		local placedOre = workspace:FindFirstChild("PlacedOre")
		if not placedOre then return notify("PlacedOre not found", COLORS.danger) end
		for _, desc in placedOre:GetDescendants() do
			if desc:IsA("BasePart") then addOreESP(desc) end
		end
	else
		for _, data in pairs(oreAdornments) do
			if data.box then data.box.Visible = false end
			if data.tracer then data.tracer.Visible = false end
		end
	end
end)
makeToggle(espSec, "Show Tracers", false, function(v) showTracers = v end)
makeSlider(espSec, "Max Distance", 50, 5000, 1000, function(v) maxEspDistance = v end)

local function setupOreConnections(placedOre)
	track(placedOre.DescendantAdded:Connect(function(d) if d:IsA("BasePart") then addOreESP(d) end end))
	track(placedOre.DescendantRemoving:Connect(function(d) removeOreESP(d) end))
	local lastCheck = 0
	track(RunService.RenderStepped:Connect(function()
		if not oreESPEnabled then return end
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera
		local now = os.clock()
		local checkDist = now - lastCheck > 0.5
		if checkDist then lastCheck = now end
		for part, data in pairs(oreAdornments) do
			if part and part.Parent and hrp then
				if checkDist then
					data.inRange = (hrp.Position - part.Position).Magnitude <= maxEspDistance
					data.box.Visible = data.inRange
				end
				if showTracers and data.inRange then
					local sp, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen then
						data.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
						data.tracer.To = Vector2.new(sp.X, sp.Y)
						data.tracer.Visible = true
					else data.tracer.Visible = false end
				else data.tracer.Visible = false end
			else data.box.Visible = false data.tracer.Visible = false end
		end
	end))
end

local existingOre = workspace:FindFirstChild("PlacedOre")
if existingOre then setupOreConnections(existingOre)
else task.spawn(function()
	local ore = workspace:WaitForChild("PlacedOre", 60)
	if ore then setupOreConnections(ore) end
end) end

-- ------------------------------------------------------------------------------
--  TELEPORTS
-- ------------------------------------------------------------------------------
local savedPosition = nil

local function teleportTo(model)
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if not model then return notify("Location not found", COLORS.danger) end
	local target = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not target then return notify("No valid part found", COLORS.danger) end
	hrp.CFrame = target.CFrame + Vector3.new(0, 5, 0)
end

local function doSavePosition()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return notify("Character not found", COLORS.danger) end
	savedPosition = hrp.CFrame
	notify("Position saved! [F2]", COLORS.success)
end

local function doReturnPosition()
	if not savedPosition then return notify("No saved position yet", COLORS.warning) end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	hrp.CFrame = savedPosition
	notify("Returned to saved position! [F3]", COLORS.success)
end

local locSec   = makeSection(teleportTab, "Locations")
local storeSec = makeSection(teleportTab, "Stores")
local posSec   = makeSection(teleportTab, "Saved Position")

makeButton(locSec, "Mine", function() teleportTo(workspace:FindFirstChild("CollapseStuff")) end)
makeButton(locSec, "My Plot [F4]", function()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return notify("Plots folder not found", COLORS.danger) end
	local myPlot
	for _, plot in plots:GetChildren() do
		local id = plot:GetAttribute("PlayerId") or plot:GetAttribute("OwnerId") or plot:GetAttribute("Owner") or plot:GetAttribute("UserId")
		if id == LocalPlayer.UserId then myPlot = plot break end
	end
	if myPlot then teleportTo(myPlot) else notify("Your plot was not found", COLORS.danger) end
end)

for _, storeName in ipairs({ "Explosives Store", "Pickaxe Store", "Backpack Store", "Prestige Store" }) do
	makeButton(storeSec, storeName, function() teleportTo(workspace:FindFirstChild(storeName)) end)
end

makeButton(posSec, "Save Position [F2]", doSavePosition)
makeButton(posSec, "Return to Saved [F3]", doReturnPosition)

-- ------------------------------------------------------------------------------
--  MISC
-- ------------------------------------------------------------------------------
local DEFAULT_SPEED = 16
local BOOST_SPEED   = 50
local walkBoostOn   = false
local infJumpOn     = false
local noclipOn      = false

local function applyWalkSpeed(speed)
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = speed end
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum and walkBoostOn then hum.WalkSpeed = BOOST_SPEED end
end))

local moveSec  = makeSection(miscTab, "Movement")
local utilSec  = makeSection(miscTab, "Utilities")
local sellSec  = makeSection(miscTab, "Auto Sell")

makeSlider(moveSec, "Boost WalkSpeed", 16, 250, 50, function(v) BOOST_SPEED = v if walkBoostOn then applyWalkSpeed(BOOST_SPEED) end end)
makeToggle(moveSec, "WalkSpeed Boost [F1]", false, function(v)
	walkBoostOn = v
	applyWalkSpeed(v and BOOST_SPEED or DEFAULT_SPEED)
end)
makeToggle(moveSec, "Infinite Jump", false, function(v) infJumpOn = v end)
makeToggle(moveSec, "Noclip", false, function(v) noclipOn = v end)

makeButton(utilSec, "Refresh Cooldowns", function()
	local char = LocalPlayer.Character
	if not char then return end
	local hrp, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	local savedCFrame = hrp.CFrame
	local conn
	conn = LocalPlayer.CharacterAdded:Connect(function(newChar)
		conn:Disconnect()
		local newHRP = newChar:WaitForChild("HumanoidRootPart", 10)
		if newHRP then task.wait(0.2) newHRP.CFrame = savedCFrame end
	end)
	hum.Health = 0
end)

-- Auto Sell
local autoSellEnabled = false
local autoSellThread  = nil
local SELL_INTERVAL   = 60

local function getUnloader()
	local ok, result = pcall(function() return workspace.FactoryGridItemsClient.DSBuild3.DSBuild3.Unloader1 end)
	if ok and result then return result end
	local factory = workspace:FindFirstChild("FactoryGridItemsClient")
	if factory then
		for _, desc in factory:GetDescendants() do
			if desc:IsA("Model") and string.find(string.lower(desc.Name), "unloader") then return desc end
		end
	end
	return nil
end

local function doSell()
	local char = LocalPlayer.Character
	if not char then return notify("Sell Failed: No character", COLORS.danger) end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return notify("Sell Failed: No HRP", COLORS.danger) end
	local unloader = getUnloader()
	if not unloader then return notify("Sell Failed: Unloader not found", COLORS.danger) end
	local returnCFrame = hrp.CFrame
	local prompt = unloader:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt and fireproximityprompt then
		local promptPart = prompt.Parent:IsA("BasePart") and prompt.Parent or unloader.PrimaryPart
		if promptPart then
			hrp.CFrame = promptPart.CFrame + Vector3.new(0, 3, 0)
			task.wait(0.5) fireproximityprompt(prompt) task.wait(0.5)
			hrp.CFrame = returnCFrame return
		end
	end
	local cd = unloader:FindFirstChildWhichIsA("ClickDetector", true)
	if cd and fireclickdetector then fireclickdetector(cd) return end
	local sellPart = unloader.PrimaryPart or unloader:FindFirstChildWhichIsA("BasePart")
	if not sellPart then return notify("Sell Failed: No parts", COLORS.danger) end
	hrp.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
	task.wait(0.8)
	pcall(function()
		if VIM then VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) task.wait(0.2) VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end
	end)
	task.wait(0.5) hrp.CFrame = returnCFrame
	notify("Sold!", COLORS.success)
end

local function stopAutoSell()
	autoSellEnabled = false
	if autoSellThread then task.cancel(autoSellThread) autoSellThread = nil end
end

local function startAutoSell()
	autoSellThread = task.spawn(function()
		while autoSellEnabled do
			doSell()
			local e = 0
			while e < SELL_INTERVAL and autoSellEnabled do task.wait(1) e += 1 end
		end
	end)
end

makeButton(sellSec, "Sell Now", doSell)
makeSlider(sellSec, "Sell Interval (s)", 10, 300, 60, function(v) SELL_INTERVAL = v end)
makeToggle(sellSec, "Auto Sell", false, function(v)
	if v then autoSellEnabled = true startAutoSell() else stopAutoSell() end
end)

-- Noclip loop
track(RunService.Stepped:Connect(function()
	if noclipOn then
		local char = LocalPlayer.Character
		if char then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
			end
		end
	end
end))

-- ------------------------------------------------------------------------------
--  VISUALS
-- ------------------------------------------------------------------------------
local fullbrightEnabled = false
local defaultLighting = {
	Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
	Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd, GlobalShadows = Lighting.GlobalShadows,
}

local function applyFullbright()
	if fullbrightEnabled then
		Lighting.Ambient = Color3.new(1,1,1) Lighting.OutdoorAmbient = Color3.new(1,1,1)
		Lighting.Brightness = 2 Lighting.ClockTime = 14 Lighting.FogEnd = 100000 Lighting.GlobalShadows = false
	else
		Lighting.Ambient = defaultLighting.Ambient Lighting.OutdoorAmbient = defaultLighting.OutdoorAmbient
		Lighting.Brightness = defaultLighting.Brightness Lighting.ClockTime = defaultLighting.ClockTime
		Lighting.FogEnd = defaultLighting.FogEnd Lighting.GlobalShadows = defaultLighting.GlobalShadows
	end
end

local envSec = makeSection(visualsTab, "Environment")
makeToggle(envSec, "Fullbright", false, function(v) fullbrightEnabled = v applyFullbright() end)
track(Lighting:GetPropertyChangedSignal("Ambient"):Connect(function() applyFullbright() end))
track(Lighting:GetPropertyChangedSignal("OutdoorAmbient"):Connect(function() applyFullbright() end))

-- ------------------------------------------------------------------------------
--  SETTINGS
-- ------------------------------------------------------------------------------
local settSec = makeSection(settingsTab, "Menu")
makeButton(settSec, "Unload Script", function()
	stopAutoSell()
	disconnectAll()
	clearAllOreESP()
	applyWalkSpeed(16)
	fullbrightEnabled = false applyFullbright()
	gui:Destroy()
	if toggleGui then toggleGui:Destroy() end
end)

-- ------------------------------------------------------------------------------
--  KEYBINDS (F1, F2, F3, F4)
-- ------------------------------------------------------------------------------
track(UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.F1 then
		walkBoostOn = not walkBoostOn
		applyWalkSpeed(walkBoostOn and BOOST_SPEED or DEFAULT_SPEED)
	end
	if input.KeyCode == Enum.KeyCode.F2 then doSavePosition() end
	if input.KeyCode == Enum.KeyCode.F3 then doReturnPosition() end
	if input.KeyCode == Enum.KeyCode.F4 then
		local plots = workspace:FindFirstChild("Plots")
		if not plots then return notify("Plots not found", COLORS.danger) end
		local myPlot
		for _, plot in plots:GetChildren() do
			local id = plot:GetAttribute("PlayerId") or plot:GetAttribute("OwnerId") or plot:GetAttribute("Owner") or plot:GetAttribute("UserId")
			if id == LocalPlayer.UserId then myPlot = plot break end
		end
		if myPlot then teleportTo(myPlot) else notify("Plot not found", COLORS.danger) end
	end
	if input.KeyCode == Enum.KeyCode.Space and infJumpOn then
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end
end))

-- ------------------------------------------------------------------------------
--  BOTAO FLUTUANTE
-- ------------------------------------------------------------------------------
local toggleGui = Instance.new("ScreenGui")
toggleGui.Name = "OTIMOSToggle"
toggleGui.ResetOnSpawn = false
toggleGui.DisplayOrder = 1000
toggleGui.IgnoreGuiInset = true
toggleGui.Parent = game:GetService("CoreGui")

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 90, 0, 32)
toggleBtn.Position = UDim2.new(1, -100, 0, 10)
toggleBtn.BackgroundColor3 = COLORS.sidebar
toggleBtn.TextColor3 = COLORS.accent
toggleBtn.Text = ">> Menu"
toggleBtn.TextSize = 12
toggleBtn.Font = Enum.Font.GothamSemibold
toggleBtn.BorderSizePixel = 0
toggleBtn.AutoButtonColor = false
toggleBtn.Parent = toggleGui
corner(toggleBtn, 8)
stroke(toggleBtn, COLORS.border)

toggleBtn.MouseEnter:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.15), { BackgroundColor3 = COLORS.card }):Play() end)
toggleBtn.MouseLeave:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.15), { BackgroundColor3 = COLORS.sidebar }):Play() end)

local menuVisible2 = true
toggleBtn.MouseButton1Click:Connect(function()
	menuVisible2 = not menuVisible2
	main.Visible = menuVisible2
	toggleBtn.Text = menuVisible2 and ">> Menu" or "<< Menu"
end)

local dragging2, dragStart2, btnStart2
toggleBtn.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging2 = true dragStart2 = i.Position btnStart2 = toggleBtn.Position
		i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging2 = false end end)
	end
end)
UIS.InputChanged:Connect(function(i)
	if dragging2 and i.UserInputType == Enum.UserInputType.MouseMovement then
		local d = i.Position - dragStart2
		toggleBtn.Position = UDim2.new(btnStart2.X.Scale, btnStart2.X.Offset + d.X, btnStart2.Y.Scale, btnStart2.Y.Offset + d.Y)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	main.Visible = false
	menuVisible2 = false
	toggleBtn.Text = "<< Menu"
end)
